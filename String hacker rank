#include<stdio.h>
#include<string.h>
int pal(char s[],int i,int j)
{
if(i>j)
return 0;
if(i==j)
return 1;
if(s[i]==s[j])
return 2+pal(s,i+1,j-1);
int a=pal(s,i+1,j);
int b=pal(s,i,j-1);
if(a>b)
return a;
else
return b;
}
int main()
{
char s[100];
scanf("%s",s);
int n=strlen(s);
printf("%d",pal(s,0,n-1));
return 0;
}
