#include<stdio.h>
#include<limits.h>
int main()
{
int V,N;
scanf("%d%d",&V,&N);
int arr[N];
for(int i=0;i<N;i++)
scanf("%d",&arr[i]);
int dp[V+1];
for(int i=0;i<=V;i++) 
{
dp[i]=INT_MAX;
}
dp[0]=0;
for(int i=1;i<=V;i++) 
{
for(int j=0;j<N;j++) 
{
if(arr[j]<=i&&dp[i-arr[j]]!=INT_MAX) 
{
if(dp[i-arr[j]]+1<dp[i]) 
{
dp[i]=dp[i-arr[j]]+1;
}
}
}
}
if(dp[V]==INT_MAX) 
{
printf("-1\n");
return 0;
}
printf("%d\n",dp[V]);
return 0;
}
