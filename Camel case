#include<stdio.h>
#include<string.h>
#include<ctype.h>
int main()
{
int n;
char input[1000];
char pattern[100];
scanf("%d",&n);
scanf(" %[^\n]",input);
scanf("%s",pattern);
char words[100][100];
int i,j,k;
int word=0;
int letter=0;
for(i=0;input[i]!='\0';i++)
{
if(input[i]==',')
{
words[word][letter]='\0';
word++;
letter=0;
}
else
{
words[word][letter]=input[i];
letter++;
}
}
words[word][letter]='\0';
word++;
int found=0;
for(i=0;i<word;i++)
{
char abbreviation[100];
k=0;
for(j=0;words[i][j]!='\0';j++)
{
if(isupper(words[i][j]))
{
abbreviation[k]=words[i][j];
k++;
}
}
abbreviation[k]='\0';
int match=1;
for(j=0;pattern[j]!='\0';j++)
{
if(abbreviation[j]!=pattern[j])
{
match=0;
break;
}
}
if(match)
{
printf("%s\n",words[i]);
found=1;
}
}
if(found==0)
{
printf("No match found");
}
return 0;
}
