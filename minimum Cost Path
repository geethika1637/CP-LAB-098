#include<stdio.h>
int main() 
{
int n,m;
scanf("%d %d",&n,&m);
int grid[n][m];
long dp[n][m];
for(int i=0;i<n;i++) 
{
for(int j=0;j<m;j++) 
{
scanf("%d",&grid[i][j]);
}
}
dp[0][0]=grid[0][0];
for(int i=0;i<n;i++) 
{
for(int j=0;j<m;j++) 
{
if(i==0&&j==0) 
{
continue;
}
if(i==0) 
{
dp[i][j]=dp[i][j-1]+grid[i][j];
}
else if(j==0) 
{
dp[i][j]=dp[i-1][j]+grid[i][j];
}
else 
{
long min=dp[i-1][j];
if(dp[i][j-1]<min)
min=dp[i][j-1];
if(dp[i-1][j-1]<min)
min=dp[i-1][j-1];
dp[i][j]=min+grid[i][j];
}
}
}
printf("%lld\n",dp[n - 1][m - 1]);
return 0;
}
