#include <stdio.h>
int main()
{
    int n, i, small,large, temp;
    scanf("%d", &n);
    int arr[n];
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }
    for(i = 0; i < n; i++)
    {
        if(arr[i] < arr[small])
            small = i;
    }
    for(i = 0; i < n; i++)
    {
        if(arr[i] > arr[large])
            large = i;
    }
    temp = arr[small];
    arr[small] = arr[large];
    arr[large] = temp;
    for(i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }
    return 0;
}
